function [output_col] = output_sizing_results(aircraft)
%UNTITLED2 Summary of this function goes here
%   Detailed explanation goes here

f_vol = aircraft.weights.fuel_volume;

perf = aircraft.performace;
ff = aircraft.performace.fuel_fraction;

output_col = [aircraft.weights.MTOW;...
    aircraft.weights.OEW;...
    aircraft.geometry.wing.S_ref;...
    aicraft.geometry.wing.span;
    perf.TW_design;...
    perf.aerodynamics.lift_to_drag;...
    aircraft.weights.fuel_volume;...
    aircraft.cost.unit_cost;
    aircraft.cost.program_cost;...
    ff.takeoff * 100;...
    ff.takeoff * ff.climb * 100;...
    ff.takeoff * ff.climb * ff.cruise * 100;...
    ff.takeoff * ff.climb * ff.cruise * ff.dash * 100;...
    ff.takeoff * ff.climb * ff.cruise * ff.dash * ff.combat * 100;...
    ff.loiter * 100;...
    ff.cruise_back * 100;...
    ff.descent * 100;...
    ff.landing * 100;...
    ];

end